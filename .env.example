# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Model API auth token (required unless SOP_LLM_MODE=mock or testers paste a key in the UI)
ANTHROPIC_API_KEY=

# --- Model selection
# anthropic = call Claude; mock = offline regex/template test double (no key needed)
# anthropic = the model (key required) | mock = offline test double | auto = the model when a key is
# available (from the UI's Settings dialog or from here), otherwise the offline double
SOP_LLM_MODE=anthropic
# Model that phrases the replies
SOP_MODEL=claude-opus-5-5
# Model for the structured calls (understand / resolve / summarize); set to the SOP_MODEL value to use one model for everything
SOP_MODEL_UNDERSTAND=claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max  (none = do not send the parameter)
SOP_EFFORT=low
SOP_EFFORT_UNDERSTAND=low
# Server-side refusal fallback opt-in: auto (on for models that support it) | on | off
SOP_REFUSAL_FALLBACK=auto

# --- Demo clock
# The fixtures are dated around early March 2026, so the agent reasons with this date.
# Set to "real" to use today's date (appeal deadlines in the fixtures will then be in the past).
SOP_TODAY=2026-03-02

# --- SOP limits
SOP_REQUIRED_ID_MATCHES=3
SOP_MAX_FAILED_ATTEMPTS=3
SOP_OUT_OF_SCOPE_LIMIT=3
SOP_MAX_PERSUASION_ATTEMPTS=2

# --- Demo aids
# Show the fixture identities/claims in the UI's "Test data" drawer (turn off outside demos)
SOP_EXPOSE_FIXTURES=1

# --- Server
HOST=127.0.0.1
PORT=8000

# --- Serving and limits (README, "Scaling and limits"); the values shown are the defaults
# Worker processes; more than 1 needs the shared SQLite store below
SOP_WORKERS=1
# Where conversations live: memory (one process) | sqlite:///path/sessions.db or a plain path (shared by workers and instances on one machine)
SOP_SESSION_STORE=memory
# Conversations held at once; the least recently used is dropped beyond this (it then answers 404)
SOP_MAX_SESSIONS=50000
# Memory store: conversation state held, in MB; the least recently used is dropped beyond this too (0 = no limit)
SOP_MAX_STORE_MB=1024
# An idle conversation expires after this many seconds
SOP_SESSION_TTL_SECONDS=14400
# Turns processed at once per process; a turn that waits longer than SOP_TURN_SLOT_WAIT_SECONDS gets 503 server_busy
SOP_MAX_CONCURRENT_TURNS=64
SOP_TURN_SLOT_WAIT_SECONDS=2
# A second message to a conversation that is mid-turn waits this long, then gets 409 conversation_busy
SOP_CONVERSATION_WAIT_SECONDS=5
# SQLite store: a crashed worker's hold on a conversation lapses after this many seconds (longer than any turn)
SOP_TURN_LEASE_SECONDS=300
# Caller messages per conversation; the last one is answered by a handoff to a human
SOP_MAX_TURNS_PER_CONVERSATION=60
# Per-client limit (per instance), messages per minute; new conversations get a quarter. 0 = off
SOP_RATE_LIMIT_PER_MINUTE=0
# 1 = the client is the last X-Forwarded-For hop (only behind your own proxy); 0 = the socket peer
SOP_TRUST_PROXY=0
# Offline double only: sleep this long in every simulated model call, for load tests
SOP_MOCK_LATENCY_MS=0
